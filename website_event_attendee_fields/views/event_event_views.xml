<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record model="ir.ui.view" id="view_event_event_form">
        <field name="name">event.event.form.attendee.fields</field>
        <field name="model">event.event</field>
        <field name="inherit_id" ref="event.view_event_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//page[@name='questions']/field[@name='question_ids']/form//field[@name='question_type']"
                position="after"
            >
                <field
                    name="partner_field"
                    invisible="question_type != 'partner_field'"
                    required="question_type == 'partner_field'"
                    options="{'no_create': 1}"
                />
                <field name="partner_field_type" invisible="1" />
                <field
                    name="partner_field_domain"
                    invisible="question_type != 'partner_field' or partner_field_type != 'many2one'"
                />
            </xpath>
        </field>
    </record>
</odoo>
