<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template
        id="event_description_full"
        inherit_id="website_event.event_description_full"
    >
        <xpath
            expr="//t[@t-call='website_event.event_details']/section"
            position="attributes"
        >
            <attribute
                name="t-cache"
                add="request.env.user._is_public()"
                separator=","
            />
        </xpath>
    </template>

    <template
        id="registration_template"
        inherit_id="website_event.registration_template"
        priority="100"
    >
        <xpath expr="//div" position="before">
            <t t-set="is_user_public" t-value="request.env.user._is_public()" />
        </xpath>
        <xpath expr="//button[@type='button']" position="replace">
            <t t-if="is_user_public">
                <a
                    t-attf-href="/web/login?redirect=#{quote_plus(request.httprequest.full_path)}"
                    class="btn btn-primary w-100"
                >Sign in (Sign up) to proceed</a>
            </t>
            <t t-else="">$0</t>
        </xpath>
    </template>
</odoo>
